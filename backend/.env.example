PORT=5005
JWT_SECRET=your_super_secret_jwt_key_change_this

# --- MySQL Database Configuration ---
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=crm_workspace

# --- Cloudinary (Optional - for cloud file storage) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Meta/Facebook OAuth ---
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:5005/api/meta-ads/callback

# --- Encryption Key for Meta Access Tokens ---
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6

# --- Rate Limiting (skipped automatically when NODE_ENV is not production) ---
# Set DISABLE_RATE_LIMIT=true to force off in production (not recommended)
DISABLE_RATE_LIMIT=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000
AUTH_RATE_LIMIT_MAX=50

# --- Frontend URL (for CORS) ---
FRONTEND_URL=http://localhost:5173
